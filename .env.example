# ─────────────────────────────────────────────────────────────
# Oh-TEN-tic! Paskorisyuhan 2026 — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. On Vercel, add these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1) ── Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets registration sync (Phase 2) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_REGISTRATION_ID=
GOOGLE_SHEETS_REGISTRATION_RANGE=Form Responses 1!A:Z
# Shared secret for the scheduled sync endpoint (any long random string)
SYNC_CRON_SECRET=

# ── Meta / Facebook Page (Phase 6) ──
FACEBOOK_PAGE_ID=
# Long-lived Page access token. SERVER ONLY.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v21.0
